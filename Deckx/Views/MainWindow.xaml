<Window x:Class="Deckx.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Deckx"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        ShowInTaskbar="True">

    <Border Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource PanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="14,14,6,6">

        <StackPanel x:Name="PanelRoot" Width="520">

            <!-- Cabecera: titulo, buscador y controles; por aqui se arrastra -->
            <Grid x:Name="HeaderBar" Margin="0,0,8,12" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xF0E2;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="16"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Mis accesos"
                               Margin="8,0,0,0"
                               FontSize="14"
                               Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBox x:Name="SearchBox"
                         Grid.Column="1"
                         Style="{StaticResource FieldBox}"
                         Width="150"
                         HorizontalAlignment="Right"
                         Margin="0,0,8,0"
                         TextChanged="SearchBox_TextChanged"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="PinButton"
                            Style="{StaticResource HeaderButton}"
                            Content="&#xE840;"
                            ToolTip="Mantener encima"
                            Click="PinButton_Click"/>
                    <Button x:Name="CollapseButton"
                            Style="{StaticResource HeaderButton}"
                            Content="&#xE70D;"
                            ToolTip="Colapsar"
                            Click="CollapseButton_Click"/>
                    <Button Style="{StaticResource HeaderButton}"
                            Content="&#xE712;"
                            ToolTip="Opciones"
                            Click="OptionsButton_Click"/>
                    <Button Style="{StaticResource HeaderButton}"
                            Content="&#xE8BB;"
                            ToolTip="Cerrar"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- Cuerpo: chips de grupo, mosaicos y pista -->
            <StackPanel x:Name="BodyPanel">

                <WrapPanel x:Name="GroupsPanel" Margin="0,0,0,10"/>

                <WrapPanel x:Name="TilesPanel"/>

                <Border BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="0,1,0,0"
                        Margin="0,2,8,0"
                        Padding="0,8,0,0">
                    <TextBlock Text="Clic: abrir  -  Clic derecho: menu  -  Arrastra un mosaico para reordenar"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"/>
                </Border>

            </StackPanel>

        </StackPanel>
    </Border>
</Window>
