<Window x:Class="Deckx.Views.EditItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acceso"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="460"
        WindowStartupLocation="CenterOwner">

    <Border Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource PanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="16">

        <StackPanel>

            <!-- Cabecera -->
            <Grid Margin="0,0,0,14">
                <TextBlock x:Name="TitleText"
                           Text="Nuevo acceso"
                           FontSize="14"
                           Foreground="{StaticResource TextBrush}"
                           VerticalAlignment="Center"/>
                <Button Style="{StaticResource HeaderButton}"
                        Content="&#xE8BB;"
                        HorizontalAlignment="Right"
                        Click="CancelButton_Click"/>
            </Grid>

            <!-- Datos del acceso -->
            <TextBlock Text="Nombre" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="NameBox" Style="{StaticResource FieldBox}" Margin="0,0,0,10"/>

            <TextBlock Text="Descripcion corta" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="SubtitleBox" Style="{StaticResource FieldBox}" Margin="0,0,0,10"/>

            <TextBlock Text="Categoria" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
            <WrapPanel x:Name="GroupsPanel" Margin="0,0,0,10"/>

            <TextBlock Text="Que debe abrir" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="PathBox" Grid.Column="0" Style="{StaticResource FieldBox}"/>
                <Button Grid.Column="1"
                        Style="{StaticResource HeaderButton}"
                        Content="&#xE8E5;"
                        ToolTip="Buscar archivo"
                        Margin="4,0,0,0"
                        Click="BrowseFileButton_Click"/>
                <Button Grid.Column="2"
                        Style="{StaticResource HeaderButton}"
                        Content="&#xE8B7;"
                        ToolTip="Buscar carpeta"
                        Click="BrowseFolderButton_Click"/>
            </Grid>

            <TextBlock Text="Argumentos (opcional)" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="ArgumentsBox" Style="{StaticResource FieldBox}" Margin="0,0,0,12"/>

            <TextBlock Text="Icono" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
            <WrapPanel x:Name="IconsPanel" Margin="0,0,0,12"/>

            <TextBlock Text="Color" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
            <WrapPanel x:Name="ColorsPanel" Margin="0,0,0,14"/>

            <!-- Vista previa y acciones -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="PreviewTile"
                        Grid.Column="0"
                        Width="116"
                        Height="88"
                        CornerRadius="10"
                        Padding="10"
                        Background="#378ADD">
                    <DockPanel LastChildFill="True">
                        <TextBlock x:Name="PreviewIcon"
                                   DockPanel.Dock="Top"
                                   Text="&#xE700;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="18"
                                   Foreground="White"/>
                        <StackPanel VerticalAlignment="Bottom">
                            <TextBlock x:Name="PreviewName"
                                       Text="Nombre"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="PreviewSubtitle"
                                       Text="Descripcion"
                                       FontSize="11"
                                       Opacity="0.85"
                                       Foreground="White"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom">
                    <Button Style="{StaticResource GhostButton}"
                            Content="Cancelar"
                            Margin="0,0,8,0"
                            Click="CancelButton_Click"/>
                    <Button Style="{StaticResource PrimaryButton}"
                            Content="Guardar"
                            Click="SaveButton_Click"/>
                </StackPanel>
            </Grid>

        </StackPanel>
    </Border>
</Window>
